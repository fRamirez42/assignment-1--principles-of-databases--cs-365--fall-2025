<!ELEMENT student-person (university)>        <!-- Root element that wraps the entire university data -->
<!ELEMENT university (student+)>              <!-- University groups one or more students together -->
<!ATTLIST university name CDATA #REQUIRED>    <!-- University has a required name attribute -->
<!-- Student groups core identity (names) separately from detailed info for clarity -->
<!ELEMENT student (name, preferred-name, student-info)>
<!ELEMENT name (#PCDATA)>                     <!-- Name is plain text -->
<!ELEMENT preferred-name (#PCDATA)>            <!-- Preferred name is plain text -->
<!-- Student-info holds all secondary details (contact, academic, dates) to keep them organized under one section -->
<!ELEMENT student-info (student-id, email, phone, status-year, gpa, major, minor, status-time, advisor, date-start, graduation)>
<!ELEMENT student-id (#PCDATA)>               <!-- Student ID is plain text -->
<!ELEMENT email (#PCDATA)>                    <!-- Email is plain text -->
<!ELEMENT phone (#PCDATA)>                    <!-- Phone number is plain text -->
<!ELEMENT status-year (#PCDATA)>              <!-- Status-year is plain text -->
<!ELEMENT gpa (#PCDATA)>                      <!-- GPA is plain text -->
<!ELEMENT major (#PCDATA)>                    <!-- Major is plain text -->
<!ELEMENT minor (#PCDATA)>                    <!-- Minor is plain text -->
<!ELEMENT status-time (#PCDATA)>              <!-- Status-time (full-time/part-time) is plain text -->
<!ELEMENT advisor (#PCDATA)>                  <!-- Advisor is plain text -->
<!ELEMENT date-start (#PCDATA)>               <!-- Start date is plain text -->
<!ELEMENT graduation (#PCDATA)>               <!-- Graduation date is plain text -->
